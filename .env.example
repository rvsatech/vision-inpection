# ─────────────────────────────────────────────────────────────
# Vision Inspect — variáveis de ambiente (desenvolvimento local)
# Copie para .env:  cp .env.example .env
# O docker-compose lê este arquivo; a API e o worker também
# (rodando fora do Docker, ajuste os hosts para localhost).
# ─────────────────────────────────────────────────────────────

# ── Banco (PostgreSQL) ───────────────────────────────────────
POSTGRES_USER=vision
POSTGRES_PASSWORD=vision
POSTGRES_DB=vision
DATABASE_URL=postgresql://vision:vision@localhost:5432/vision
# Conexão direta para migrations (no Supabase, a porta 5432 sem pooler)
DIRECT_DATABASE_URL=postgresql://vision:vision@localhost:5432/vision

# ── Redis (fila: Redis Streams) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API (NestJS) ─────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-em-producao-com-48-bytes-aleatorios
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRIAL_DAYS=14
PAST_DUE_GRACE_DAYS=7
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_MAX_FILE_MB=10
FILE_RETENTION_DAYS=90

# Token compartilhado API ⇄ worker (rotas /internal). Gere um valor aleatório.
INTERNAL_API_TOKEN=dev-internal-token-troque-me

# ── Armazenamento de imagens ─────────────────────────────────
# local    → pasta compartilhada (docker volume) — desenvolvimento
# supabase → Supabase Storage (produção no plano gratuito)
STORAGE_DRIVER=local
STORAGE_DIR=../../storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=inspections

# ── Stripe (SOMENTE modo de teste) ───────────────────────────
# Dashboard → Developers → API keys (modo teste). Chaves live são recusadas.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Gerados por: npm run stripe:bootstrap -w apps/api
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# `stripe listen --forward-to localhost:8080/webhooks/stripe` mostra o whsec_
STRIPE_WEBHOOK_SECRET=

# ── Worker (Go) ──────────────────────────────────────────────
WORKER_HTTP_ADDR=:8080
API_INTERNAL_URL=http://localhost:4000
VISION_URL=http://localhost:8000
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3

# ── Serviço de visão (Python) ────────────────────────────────
VISION_STORAGE_DIR=../../storage
# auto → usa YOLO se houver pesos em services/vision/models; senão OpenCV
VISION_BACKEND=auto

# ── Seed (dados de demonstração) ─────────────────────────────
# Em produção SEED_ADMIN_PASSWORD é obrigatório (conta admin da plataforma).
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ── Frontend (Next.js) ───────────────────────────────────────
# true = mostra a credencial de demonstração na tela de login
NEXT_PUBLIC_DEMO_MODE=true
# URL da API vista pelo servidor do Next (rewrites /api/* → API)
API_URL=http://localhost:4000
