{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vision.infer.response.v1",
  "title": "Resultado de inferência (Visão → Worker → API)",
  "type": "object",
  "required": ["analysisId", "service", "mode", "modelVersion", "latencyMs", "image", "summary", "detections"],
  "properties": {
    "analysisId": { "type": "string" },
    "service": { "enum": ["QUALITY_DEFECT", "PPE_COMPLIANCE", "OBJECT_COUNT"] },
    "mode": { "enum": ["yolo", "heuristic"], "description": "yolo = modelo treinado; heuristic = pipeline OpenCV clássico (fallback sem pesos)." },
    "modelVersion": { "type": "string" },
    "latencyMs": { "type": "number", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } }
    },
    "summary": {
      "type": "object",
      "required": ["verdict", "headline", "metrics"],
      "properties": {
        "verdict": { "enum": ["PASS", "FAIL", "INFO"] },
        "headline": { "type": "string" },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": {
            "type": "object",
            "description": "Coordenadas normalizadas (0..1) relativas à imagem.",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" }, "y": { "type": "number" },
              "w": { "type": "number" }, "h": { "type": "number" }
            }
          },
          "severity": { "enum": ["info", "warning", "critical"] }
        }
      }
    }
  }
}
